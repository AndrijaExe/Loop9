ProjectName=Loop 9

[/Script/EngineSettings.GeneralProjectSettings]
ProjectID=AB1C13684F34781DE0B48EA4C51030BC

[/Script/UnrealEd.ProjectPackagingSettings]
; Cultures included in packaged builds. Add a line per supported language.
+CulturesToStage=en
+CulturesToStage=sr
+CulturesToStage=de
+CulturesToStage=fr
+CulturesToStage=ru

[Internationalization]
; Where the game looks for compiled .locres files at runtime.
+LocalizationPaths=%GAMEDIR%Content/Localization/Game

[/Script/Loop9.InspectionStageActor]
; Item inspection "black room" tuning (all optional).
; ExposureBias: stops, higher = brighter (default 0.0).
; Key/FillLightIntensityCandela: stage lights (defaults 300 / 75).
;ExposureBias=0.0
;KeyLightIntensityCandela=300.0
;FillLightIntensityCandela=75.0

[/Script/Loop9.AI_Friend]
; Production uses Steam session authentication. Never package a game token.
APIEndpoint=https://your-backend.example.com/api/chat
; Optional: force AI reply language ("sr", "en"...). Leave out to follow the UI language from Settings.
;PreferredLanguage=sr
