msgid "You: "
msgstr "Ti: "

#. Key: FriendPrefix
msgctxt "Loop9Chat,FriendPrefix"
msgid "Dragojlo: "
msgstr "Dragojlo: "

#. Key: PhoneRinging
msgctxt "Loop9Chat,PhoneRinging"
msgid "Phone ringing..."
msgstr "Telefon zvoni..."

#. Key: LowSignalReply
msgctxt "Loop9Chat,LowSignalReply"
msgid "Low signal. Try again later."
msgstr "Slab signal. Pokušaj kasnije."

#. Key: ChatConnectionLost
msgctxt "Loop9Chat,ChatConnectionLost"
msgid "...the line crackles and goes dead. (No connection. Check your internet and try again.)"
msgstr "...veza krči i prekida se. (Nema konekcije. Proveri internet i pokušaj ponovo.)"

#. Key: ChatRateLimited
msgctxt "Loop9Chat,ChatRateLimited"
msgid "...the line is busy. He cannot take more calls right now. Try again later."
msgstr "...linija je zauzeta. Ne može trenutno da prima više poziva. Pokušaj kasnije."

#. Key: ChatServerError
msgctxt "Loop9Chat,ChatServerError"
msgid "...static hisses through the receiver. Something is wrong on the other side. Try again."
msgstr "...šum krči kroz slušalicu. Nešto nije u redu sa druge strane. Pokušaj ponovo."

#. Key: InitialRuleMessage
msgctxt "Loop9Chat,InitialRuleMessage"
msgid "Listen carefully: if you notice any irregularity, take the elevator that has interior light on (RESTART). If you find no anomaly, take the elevator without interior light (NEXT). The first loop is clean, so take your time and learn the baseline."
msgstr "Slušaj me pažljivo: ako primetiš bilo kakvu nepravilnost, uđi u lift u kom je upaljeno svetlo (RESTART). Ako ne nađeš anomaliju, uđi u lift bez svetla (DALJE). Prva petlja je čista, zato ne žuri i dobro upamti kako sve izgleda."

#. Key: ContinueButtonLabel
msgctxt "Loop9Endings,ContinueButtonLabel"
msgid "Return to Main Menu"
msgstr "Nazad na glavni meni"

#. Key: EscapeTogetherTitle
msgctxt "Loop9Endings,EscapeTogetherTitle"
msgid "ESCAPE TOGETHER"
msgstr "BEKSTVO ZAJEDNO"

#. Key: EscapeTogetherDesc
msgctxt "Loop9Endings,EscapeTogetherDesc"
msgid "You and Dragojlo built trust without losing yourself. You escaped the loop together."
msgstr "Ti i Dragojlo ste izgradili poverenje, a ti nisi izgubio sebe. Pobegli ste iz petlje zajedno."

#. Key: ObedientFoolTitle
msgctxt "Loop9Endings,ObedientFoolTitle"
msgid "OBEDIENT FOOL"
msgstr "POSLUŠNA BUDALA"

#. Key: ObedientFoolDesc
msgctxt "Loop9Endings,ObedientFoolDesc"
msgid "You trusted completely and stopped deciding for yourself. The wrong voice chose your fate."
msgstr "Verovao si bezuslovno i prestao sam da odlučuješ. Pogrešan glas je izabrao tvoju sudbinu."

#. Key: ColdBetrayalTitle
msgctxt "Loop9Endings,ColdBetrayalTitle"
msgid "COLD BETRAYAL"
msgstr "HLADNA IZDAJA"

#. Key: ColdBetrayalDesc
msgctxt "Loop9Endings,ColdBetrayalDesc"
msgid "You relied on him but never respected him. One calm lie was enough."
msgstr "Oslanjao si se na njega, ali ga nikad nisi poštovao. Jedna mirna laž je bila dovoljna."

#. Key: MergedMemoryTitle
msgctxt "Loop9Endings,MergedMemoryTitle"
msgid "MERGED MEMORY"
msgstr "SPOJENO SEĆANJE"

#. Key: MergedMemoryDesc
msgctxt "Loop9Endings,MergedMemoryDesc"
msgid "Your memories and his leaks intertwined. You can no longer tell who remembers what."
msgstr "Tvoja sećanja i njegova curenja su se preplela. Više ne znaš ko se čega seća."

#. Key: TheReplacementTitle
msgctxt "Loop9Endings,TheReplacementTitle"
msgid "THE REPLACEMENT"
msgstr "ZAMENA"

#. Key: TheReplacementDesc
msgctxt "Loop9Endings,TheReplacementDesc"
msgid "He did not destroy you. He learned you. Now you are the voice on the other side of the line."
msgstr "Nije te uništio. Naučio te je. Sada si ti glas sa druge strane linije."

#. Key: ParanoidSurvivorTitle
msgctxt "Loop9Endings,ParanoidSurvivorTitle"
msgid "PARANOID SURVIVOR"
msgstr "PARANOIČNI PREŽIVELI"

#. Key: ParanoidSurvivorDesc
msgctxt "Loop9Endings,ParanoidSurvivorDesc"
msgid "You escaped alone by trusting nobody. Maybe that saved you. Maybe it cost you the truth."
msgstr "Pobegao si sam jer nisi verovao nikome. Možda te je to spasilo. Možda te je koštalo istine."

#. Key: EndingStatsFormat
msgctxt "Loop9Endings,EndingStatsFormat"
