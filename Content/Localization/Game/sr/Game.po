#. Key: Tip01
msgctxt "Loop9Loading,Tip01"
msgid "Look for objects that disappear..."
msgstr "Traži predmete koji nestaju..."

#. Key: Tip02
msgctxt "Loop9Loading,Tip02"
msgid "Pay close attention to your surroundings"
msgstr "Obrati pažnju na okolinu"

#. Key: Tip03
msgctxt "Loop9Loading,Tip03"
msgid "Trust your instincts, but verify everything"
msgstr "Veruj instinktu, ali proveri sve"

#. Key: Tip04
msgctxt "Loop9Loading,Tip04"
msgid "Not everything is as it seems"
msgstr "Nije sve onako kako izgleda"

#. Key: Tip05
msgctxt "Loop9Loading,Tip05"
msgid "The office changes when you're not looking"
msgstr "Kancelarija se menja kad ne gledaš"

#. Key: Tip06
msgctxt "Loop9Loading,Tip06"
msgid "Dragojlo has been here for a very long time"
msgstr "Dragojlo je ovde već jako dugo"

#. Key: Tip07
msgctxt "Loop9Loading,Tip07"
msgid "Every loop is a chance to escape"
msgstr "Svaka petlja je prilika za bekstvo"

