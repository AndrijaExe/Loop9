#: Source/Loop9/AI_Friend.cpp(592)
msgctxt "Loop9Chat,ChatServerError"
msgid "...static hisses through the receiver. Something is wrong on the other side. Try again."
msgstr "...des parasites sifflent dans le combiné. Quelque chose ne va pas de l'autre côté. Réessaie."

